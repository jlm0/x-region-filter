{
  "manifest_version": 3,
  "name": "X Region Filter",
  "version": "0.6.0",
  "description": "Hide feed posts, reposts and quotes by account region or accounts under three months old.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Region Filter",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "shared/regions.js",
        "shared/core.js",
        "content/content.js",
        "content/about.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
